# The server owns the Gemini key. Nothing Gemini-related is exposed to the browser,
# so there is no VITE_* variable here — the frontend talks to /api/* only.
GEMINI_API_KEY=replace_with_your_key

# Optional overrides, all with working defaults.
# GEMINI_MODEL=gemini-3.6-flash    # bump this when a model line is retired
# GEMINI_TIMEOUT_MS=75000          # curation budget; url_context is the slow part
# PORT=3000                        # what the Vite dev proxy targets
