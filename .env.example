# Supabase is optional. Use RLS so only safe public operations are exposed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Do NOT put a Gemini API key in VITE_* variables in production.
# The frontend calls POST /api/plan, where your server/edge function owns the Gemini key.
VITE_GEMINI_ENDPOINT=/api/plan

GEMINI_API_KEY = replace_with_your_key